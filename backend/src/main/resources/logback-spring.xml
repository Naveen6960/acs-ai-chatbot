<configuration>
  <!-- where to put logs (relative to project root) -->
  <property name="LOG_DIR" value="logs"/>

  <!-- file appender for feedback events -->
  <appender name="FEEDBACK" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/feedback-current.ndjson</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/feedback-%d{yyyy-MM-dd}.ndjson</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <!-- write exactly the JSON message we log, one line per event -->
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <!---FILE appender — new block added — saves logs to logs/application.log -->

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/application.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>


  <!-- route only the named logger "feedback" to the FEEDBACK appender -->
  <logger name="feedback" level="INFO" additivity="false">
    <appender-ref ref="FEEDBACK"/>
  </logger>

  <!-- keep your normal console logging (optional) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>



  <!---Package logger — one new line — shows DEBUG logs for our code-->
  <logger name="com.example.azureopenaiapi" level="DEBUG"/>


  <!--- Root logger — one new line added — <appender-ref ref="FILE"/> — sends logs to file too-->
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/> <!-- ← NEW LINE ADDED -->
    </root>
  </configuration>





